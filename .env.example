# Public browser URL and the port published by Docker Compose.
APP_URL=http://localhost:8080
APP_PORT=8080

# Local console credentials. Copy this file to .env and choose a strong value.
PLAYGROUND_USERNAME=admin
PLAYGROUND_PASSWORD=replace-with-a-strong-password

# PrimeVue 5 license for the browser build. Obtain a Community or Commercial key from PrimeUI.
VITE_PRIMEUI_LICENSE_KEY=
